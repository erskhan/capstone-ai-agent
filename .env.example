# ── Local Development Configuration ──────────────────────────────────────────
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.

PYTHONUNBUFFERED=1
DEBUG=True
LOG_LEVEL=INFO

# ── Database Configuration ────────────────────────────────────────────────────
# Replace <db-user>, <db-password>, <db-host>, and <db-name> with your values.
DATABASE_URL=mysql+pymysql://<db-user>:<db-password>@<db-host>:3306/<db-name>

# ── API Configuration ─────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=1

# ── Streamlit Configuration ───────────────────────────────────────────────────
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=127.0.0.1

# ── LLM / LangSmith Configuration ────────────────────────────────────────────
# LANGSMITH_API_KEY is the API key used to authenticate with the LLM gateway.
LANGSMITH_API_KEY=<your-api-key-here>
LANGSMITH_BASE_URL=https://api.smith.langchain.com
LANGSMITH_PROJECT=loan_approval_system
LANGSMITH_TRACING=true

# ── Security Configuration ────────────────────────────────────────────────────
SECRET_KEY=<generate-a-strong-random-secret-key>
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Admin login password (used by the Streamlit UI)
ADMIN_PASSWORD=<choose-a-strong-admin-password>

# ── Email Configuration (optional) ───────────────────────────────────────────
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@loanapproval.com

# ── Feature Flags ─────────────────────────────────────────────────────────────
ENABLE_ASYNC_PROCESSING=true
ENABLE_NOTIFICATIONS=false
ENABLE_MANUAL_REVIEW_QUEUE=true

# ── Performance Configuration ─────────────────────────────────────────────────
AGENT_TIMEOUT_SECONDS=30
WORKFLOW_TIMEOUT_SECONDS=60
API_RATE_LIMIT_PER_MINUTE=100
